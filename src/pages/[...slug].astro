---
// FDE、WorkBuddy 等专题页：正文片段在 src/topics/**/*.html，标题和描述在 src/topics/meta.json
import Base from '../layouts/Base.astro';
import '../styles/topic.css';
import meta from '../topics/meta.json';

const SECTIONS: Record<string, string> = { fde: 'FDE', workbuddy: 'WorkBuddy' };

export function getStaticPaths() {
  const files = import.meta.glob('../topics/**/*.html', { query: '?raw', import: 'default', eager: true });
  return Object.entries(files).map(([path, html]) => {
    const slug = path.replace('../topics/', '').replace(/\.html$/, '');
    return { params: { slug }, props: { slug, html } };
  });
}
const { slug, html } = Astro.props as { slug: string; html: string };
const info = (meta as Record<string, { title: string; description: string; shell?: string }>)[slug];
const section = slug.split('/')[0];
const isSectionHome = slug === section;
---
<Base title={info.title} description={info.description || undefined} type={isSectionHome ? 'website' : 'article'} wide>
  <p class="crumb topic-crumb">
    <a href="/practice/">实践</a>
    {!isSectionHome && <> / <a href={`/${section}/`}>{SECTIONS[section]}</a></>}
  </p>
  <div class:list={['topic', info.shell]}><Fragment set:html={html} /></div>
</Base>
